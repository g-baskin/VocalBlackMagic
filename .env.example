# Local development: Python audio APIs remain private; Vocal Fix proxies to its API.
# TTB_STUDIO_API_URL is read only by unused legacy code; TTB Studio does not call Python.
# Set these in each app's runtime environment; production upload and generation
# are intentionally blocked until SaaS authentication and tenancy exist.
VOCAL_FIX_API_URL=http://127.0.0.1:8001
TTB_STUDIO_API_URL=http://127.0.0.1:8002
VFM_DATA_DIR=./data/vocal-fix

# Hosted music generation for TTB Studio (development only until auth exists).
# Put real keys in apps/ttb-studio/.env (git-ignored), never in source or chat.
# FAL_KEY=
# GEMINI_API_KEY=
# Replicate: studio engines, lyrics, stems, reimagine and voice conversion.
# REPLICATE_API_TOKEN=
# Optional: where the studio library and shared voice registry live (default <repo>/data).
# VBM_DATA_DIR=

# Future production integrations (none configured or active).
# DATABASE_URL=
# OBJECT_STORAGE_ENDPOINT=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# AUTH_ISSUER_URL=
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
