[Unit]
Description=Vocal Black Magic - TTB Studio SvelteKit
After=network.target

[Service]
Type=simple
User=vbm
Group=vbm
WorkingDirectory=/opt/VocalBlackMagic/apps/ttb-studio
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3002
EnvironmentFile=-/etc/vbm/ttb-studio.env
ExecStart=/usr/local/bin/bun ./build
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
