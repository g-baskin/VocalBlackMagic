{
  "name": "@vbm/vocal-fix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --bun vite dev --host 127.0.0.1 --port 5173",
    "build": "bun run --bun vite build",
    "preview": "bun run --bun vite preview --host 127.0.0.1 --port 5273",
    "check": "bun run --bun svelte-kit sync && bun run --bun svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@vbm/contracts": "workspace:*",
    "@vbm/ui": "workspace:*",
    "@vbm/auth": "workspace:*",
    "@vbm/database": "workspace:*",
    "@vbm/billing": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-bun": "^1.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "@types/node": "^22.17.0"
  }
}
