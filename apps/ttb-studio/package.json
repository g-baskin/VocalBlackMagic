{
  "name": "@vbm/ttb-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --bun vite dev --host 127.0.0.1 --port 5174",
    "build": "bun run --bun vite build",
    "preview": "bun run --bun vite preview --host 127.0.0.1 --port 5274",
    "check": "bun run --bun svelte-kit sync && bun run --bun svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "@vbm/auth": "workspace:*",
    "@vbm/billing": "workspace:*",
    "@vbm/contracts": "workspace:*",
    "@vbm/database": "workspace:*",
    "@vbm/ui": "workspace:*",
    "fflate": "^0.8.3",
    "tonal": "6.5.1",
    "tone": "15.1.22",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-bun": "^1.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "1.4.4",
    "@types/node": "^22.17.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  }
}
