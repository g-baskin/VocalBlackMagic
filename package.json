{
  "name": "vocal-black-magic",
  "private": true,
  "version": "0.2.0",
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/vocal-fix",
    "apps/ttb-studio",
    "packages/*"
  ],
  "scripts": {
    "dev:vocal": "bun run --filter @vbm/vocal-fix dev",
    "dev:ttb": "bun run --filter @vbm/ttb-studio dev",
    "build": "bun run build:vocal && bun run build:ttb",
    "build:vocal": "bun run --filter @vbm/vocal-fix build",
    "build:ttb": "bun run --filter @vbm/ttb-studio build",
    "check": "bun run --filter @vbm/vocal-fix check && bun run --filter @vbm/ttb-studio check",
    "test": "bun test packages apps/ttb-studio/src apps/vocal-fix/src infra/cloudflare",
    "check:edge": "tsc -p infra/cloudflare/studio-edge/tsconfig.json",
    "edge:deploy": "cd infra/cloudflare/studio-edge && bun install --frozen-lockfile && bunx --minimum-release-age=172800 wrangler@4.158.0 deploy",
    "lint": "bun run lint:web && bun run lint:python",
    "lint:web": "eslint apps/vocal-fix apps/ttb-studio packages eslint.config.mjs --max-warnings 0",
    "lint:python": "python -m ruff check apps tests",
    "format:check": "bun run format:check:web && bun run format:check:python",
    "format:check:web": "prettier --check \"apps/**/*.{ts,js,svelte,css,html,json}\" \"packages/**/*.{ts,js,svelte,css,json}\" package.json eslint.config.mjs .prettierrc.json",
    "format:check:python": "python -m ruff format --check apps tests",
    "format": "bun run format:web && bun run format:python",
    "format:web": "prettier --write \"apps/**/*.{ts,js,svelte,css,html,json}\" \"packages/**/*.{ts,js,svelte,css,json}\" package.json eslint.config.mjs .prettierrc.json",
    "format:python": "python -m ruff format apps tests",
    "check:python": "python -m mypy",
    "test:python": "python -m pytest -q",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:engine": "cd services/audio-engine && .venv/bin/python -m pytest -q",
    "lint:engine": "cd services/audio-engine && .venv/bin/python -m ruff check . && .venv/bin/python -m ruff format --check .",
    "check:engine": "cd services/audio-engine && .venv/bin/python -m mypy"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "axe-core": "^4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.24.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
