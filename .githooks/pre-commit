#!/bin/sh
# Refuse commits whose staged changes contain secrets. Enable once per clone: bun run hooks:install
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed. Install it from https://github.com/gitleaks/gitleaks to commit." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
